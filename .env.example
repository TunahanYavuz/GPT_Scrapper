# Keep the dashboard bound to loopback; do not expose it to the internet.
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=data/campaigns.sqlite3
SOURCES_PATH=config/sources.json

# Preferred: start Chrome/Brave with remote debugging bound to loopback.
BROWSER_CDP_URL=http://127.0.0.1:9222
BROWSER_CDP_PORT=9222
AUTO_LAUNCH_BROWSER=false
BROWSER_EXECUTABLE=
BROWSER_USER_DATA_DIR=browser-profile
BROWSER_PROFILE_DIRECTORY=Default

NAVIGATION_TIMEOUT_MS=25000
MAX_CAMPAIGNS_PER_SOURCE=100
PAGE_DELAY_SECONDS=1.5
